  "hero_7_10": [
    { "id": "h_001", "level": 1, "framePrefix": "Although it was raining, they decided to go", "targetWord": "outside", "frameSuffix": ".", "phonetic": "ˌaʊtˈsaɪd", "options": ["inside", "outside", "yesterday"] },
